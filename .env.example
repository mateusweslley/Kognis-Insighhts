NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-key

# For a remote Supabase project, set NEXT_PUBLIC_SUPABASE_URL to that project's HTTPS URL
# and NEXT_PUBLIC_SUPABASE_ANON_KEY to that project's anon key. Do not use a service_role key.
